# Salin file ini menjadi `.env.local`, lalu sesuaikan isinya.

# URL base API backend Laravel.
# Hanya dibaca di sisi server (route handler), tidak pernah dikirim ke browser —
# karena itu TANPA prefix NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000/api/v1

# true  = login memakai data contoh di src/lib/mock/auth-mock.ts (backend tidak dipanggil)
# false = login memakai backend Laravel di BACKEND_URL
# Akun contoh untuk mode mock tercantum di src/lib/mock/auth-mock.ts.
AUTH_MOCK=true
